# Copy to configs/local/server.env and set every absolute path for this host.
# Parent artifacts are immutable prerequisites. Point this at a copied artifact store
# for a fully disconnected deployment; it may temporarily reference the legacy store.
export NATIVE16_MODEL_ROOT=/path/to/models
export NATIVE16_DATA_ROOT=/path/to/datasets
export NATIVE16_ARTIFACT_ROOT=/path/to/native16-gligen-artifacts
export NATIVE16_PARENT_ARTIFACT_ROOT=/path/to/native16-parent-artifacts

# Select the Python environment with CUDA-enabled PyTorch, Diffusers, and Transformers.
export NATIVE16_PY=python
export NATIVE16_TORCHRUN=torchrun
export NATIVE16_TRAIN_GPUS=0
export NATIVE16_EVAL_GPUS="0"
